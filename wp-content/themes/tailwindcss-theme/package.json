		"production": "mix --production"
	},
	"devDependencies": {
		"@jeffreyvr/tailwindcss-tailpress": "^2.0.0",
		"autoprefixer": "^10.4.0",
		"resolve-url-loader": "^5.0.0",
		"tailwindcss": "^3.4.0"
	},
	"dependencies": {
		"laravel-mix": "^6.0.49",
		"postcss": "^8.4.45",
		"postcss-import": "^16.1.0"
	}
